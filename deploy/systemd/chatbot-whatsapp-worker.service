[Unit]
Description=Chatbot WhatsApp queue worker (sends real messages)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Replace this user and both paths before installation. The root .env is loaded by Django.
User=chatbot
WorkingDirectory=/opt/chatbot2026
ExecStart=/opt/chatbot2026/venv/bin/python manage.py whatsapp_worker
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
